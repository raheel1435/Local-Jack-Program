# Port this gateway service listens on
JACK_LOCAL_PORT=43110

# Which local LLM backs /jack/chat and /jack/intent's LLM fallback:
# "llamacpp" (llama-server + a small instruction-tuned GGUF model -- fast,
# recommended) or "colibri" (kept as a fallback/reference runtime). Both
# providers are always health-checked regardless of this setting.
JACK_LLM_PROVIDER=llamacpp

# llama.cpp's built-in OpenAI-compatible server (llama-server). Unlike
# Colibri it does not validate `model` against a fixed id.
LLAMACPP_BASE_URL=http://127.0.0.1:8081

# Colibri exposes an OpenAI-compatible server (c/openai_server.py).
# Default port confirmed from colibri source: 8000 (--port flag, host 127.0.0.1).
COLIBRI_BASE_URL=http://127.0.0.1:8000
# Colibri's server validates the `model` field strictly against whatever
# model_id `coli serve` was started with (404 on any mismatch) -- it does not
# accept an arbitrary/generic name. Set this to match your running model
# (e.g. olmoe-colibri, glm-5.2-colibri, kimi-k3-colibri, inkling-colibri,
# deepseek-v4-colibri), used only when the caller's request omits `model`.
COLIBRI_MODEL_ID=colibri

# Kokoro-FastAPI confirmed default (api/src/core/config.py): host 0.0.0.0, port 8880.
KOKORO_BASE_URL=http://127.0.0.1:8880

# The provider invokes the whisper-cli executable directly rather than
# an HTTP endpoint (whisper-server.exe is also built and available under
# runtime-dependencies/whisper.cpp/build/bin/ as a future HTTP-wrapper upgrade path).
WHISPER_EXECUTABLE_PATH=../runtime-dependencies/whisper.cpp/build/bin/whisper-cli.exe
# Path to a downloaded ggml model. Corrected (WHISPER SAFETY CORRECTION
# milestone, Part 11): this used to say ../whisper.cpp/ggml-base.en.bin,
# which doesn't match the actual validated runtime path -- whisper.cpp's own
# convention (and the real .env this example mirrors) puts downloaded models
# under models/.
WHISPER_MODEL_PATH=../runtime-dependencies/whisper.cpp/models/ggml-base.en.bin

# TEST ASR engine: VibeVoice-ASR-BitNet, run via runtime-dependencies/VibeASR.cpp's asr_infer CLI.
# This is opt-in only -- Approved (Whisper) stays the default everywhere, and
# the gateway never falls back to Whisper silently if this is misconfigured
# or the request explicitly asked for "vibevoice". Leave unset to disable the
# Test engine entirely (it will report "unavailable" without affecting the
# rest of the gateway). If asr_infer.exe fails to launch with a missing-DLL
# error, copy libc++.dll, libomp.dll and libwinpthread-1.dll from your MSYS2
# clang toolchain's bin/ next to the executable.
VIBE_ASR_EXECUTABLE_PATH=../runtime-dependencies/VibeASR.cpp/build/bin/asr_infer.exe
# Persistent streaming build (VibeVoice isolated-optimization milestone) --
# same directory, "loads models once, processes audio via stdin" per its own
# --help banner. See VibeWarmServer.ts. This entry was missing from this
# example file even after the real .env gained it -- corrected here too
# (WHISPER SAFETY CORRECTION milestone, Part 11).
VIBE_ASR_STREAM_SERVER_EXECUTABLE_PATH=../runtime-dependencies/VibeASR.cpp/build/bin/asr_stream_server.exe
# GGUF weights, downloaded separately (see runtime-dependencies/VibeASR.cpp/README.md) and stored
# outside git tracking, same convention as the other GGUF weights in
# llm-models/. Both files together are ~1.58 GB.
VIBE_ASR_VAE_MODEL_PATH=C:\path\to\llm-models\vibeasr\vibeasr-vae-encoder-i8_s.gguf
VIBE_ASR_LM_MODEL_PATH=C:\path\to\llm-models\vibeasr\vibeasr-lm-i2_s-embed-q6_k.gguf

# Multi-provider AI milestone: OpenAI/Anthropic as BYOK (bring-your-own-key)
# AI-brain providers, selectable per-request via `aiProvider`, independent
# of ASR selection. These are model DEFAULTS only -- the actual API keys
# are never env vars; they're entered through the Settings UI and stored
# DPAPI-encrypted at %APPDATA%\jack-local-ai\credentials\, outside this
# repo entirely. Both values below are fast/cheap tiers, matching the
# local providers' role (short narration text, structured intent JSON
# under 512 tokens) rather than a general-purpose "biggest model" default.
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS_DEFAULT=1024
